{
  "expo": {
    "name": "cleo",
    "slug": "cleo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cleo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.cleo.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.cleo.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CLEO to access photos to upload proof of litter collection.",
          "cameraPermission": "Allow CLEO to access camera to capture proof of litter collection."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CLEO to calculate distance to assigned litter collection sites."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
