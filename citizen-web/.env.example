# Convex Cloud Deployment URL (shared with CLEO monorepo)
NEXT_PUBLIC_CONVEX_URL="https://savory-ram-12.convex.cloud"

# MobileNetV2 ONNX Litter Verification Model (relative to citizen-web/ or absolute path)
MODEL_PATH="../models/trash_classifier_384.onnx"
TRASH_THRESHOLD="0.5"

# Optional external Cloud AI (EfficientNet) waste categorization endpoint
WASTE_CATEGORY_API_URL=""

# WhatsApp Bot Channel (leave empty until WhatsApp Cloud API bot is deployed)
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_WHATSAPP_BOT_URL=""

# Fallback Messaging Bot Channel (CLEO Telegram Bot used while WhatsApp vars are empty)
NEXT_PUBLIC_TELEGRAM_BOT_HANDLE="@fyp_qwerty_bot"
NEXT_PUBLIC_TELEGRAM_BOT_URL="https://t.me/fyp_qwerty_bot"
